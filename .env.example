# mcp-env-browser Phase 1 Config Template
# Copy ke .env, edit sesuai environment

# === License Server (Phase 2 — Phase 1 default ke local) ===
# MCP_LICENSE_SERVER_URL=http://localhost:8765
# MCP_LICENSE_API_KEY=<generate via /license/register on server>

# === Vault Backend ===
# auto | secretstorage | encrypted_json
# MCP_VAULT_BACKEND=auto

# Fallback EncryptedJSONBackend passphrase (REQUIRED kalau pakai encrypted_json)
# Phase 1 warning: passphrase via env var BUKAN ideal. Phase 2 pakai master key KDF.
# MCP_VAULT_PASSPHRASE=<strong-random-string>

# === Browser Execution ===
# Local user Phase 1 pakai headless=False (knowledge.md §3 gotcha TikTok/Google blocking)
# MCP_BROWSER_HEADLESS=false

# === Monitoring ===
# Bind ke localhost only (spec §6.6.5) — jangan ubah ke 0.0.0.0
# MCP_MONITOR_HOST=127.0.0.1
# MCP_MONITOR_PORT=9876

# === Logging ===
# MCP_LOG_LEVEL=INFO
